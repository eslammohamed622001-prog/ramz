شكل {
    صفحة "الرئيسية" {
        عنوان "تطبيق الملاحظات"
        إدخال "الملاحظة" "اكتب ملاحظتك هنا..."
        زر "حفظ"
        زر "عرض"
        زر "مسح"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    عند النقر على "حفظ" {
        احفظ "ملاحظتي" من "الملاحظة"
        أظهر "تم حفظ الملاحظة بنجاح!"
    }
    
    عند النقر على "عرض" {
        ليكن النص = استرجع "ملاحظتي"
        أظهر "ملاحظتك هي: {النص}"
    }
    
    عند النقر على "مسح" {
        امسح "ملاحظتي"
        أظهر "تم مسح الملاحظة!"
    }
}