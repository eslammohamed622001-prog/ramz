شكل {
    صفحة "الرئيسية" {
        عنوان "حاسبة رَمْز"
        إدخال "الرقم" "أدخل رقماً"
        زر "احسب"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
}

معنى {
    عند النقر على "احسب" {
        ليكن الرقم = حقل "الرقم"
        ليكن النتيجة = الرقم * 2
        أظهر "النتيجة هي: {النتيجة}"
    }
}