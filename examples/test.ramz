شكل {
    صفحة "الرئيسية" {
        عنوان "مرحباً بك في رَمْز"
        زر "من نحن"
        زر "الميزات"
    }
    
    صفحة "من نحن" {
        عنوان "من نحن"
        نص "نحن فريق يبني لغة برمجة عربية أصيلة"
        زر "العودة للرئيسية"
    }
    
    صفحة "الميزات" {
        عنوان "ميزات رَمْز"
        نص "عربية، بسيطة، قوية"
        زر "العودة للرئيسية"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    عند النقر على "من نحن" {
        انتقل إلى "من نحن"
    }
    
    عند النقر على "الميزات" {
        انتقل إلى "الميزات"
    }
    
    عند النقر على "العودة للرئيسية" {
        انتقل إلى "الرئيسية"
    }
}