شكل {
    صفحة "الرئيسية" {
        عنوان "اتصل بنا"
        
        نموذج "نموذج_الاتصال" {
            حقل_نص "الاسم" "اكتب اسمك"
            حقل_بريد "البريد" "اكتب بريدك الإلكتروني"
            حقل_نص_طويل "الرسالة" "اكتب رسالتك هنا..."
            زر "إرسال"
        }
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    عند النقر على "إرسال" {
        أظهر "شكراً لتواصلك معنا! سنرد عليك قريباً"
    }
}