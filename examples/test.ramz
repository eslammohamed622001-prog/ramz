شكل {
    صفحة "الرئيسية" {
        عنوان "اختبار شامل"
        إدخال "الرقم" "أدخل رقماً أو نصاً"
        زر "احسب الضعف"
        زر "احفظ الاسم"
        زر "عرض الاسم"
    }
}

معنى {
    عند النقر على "احسب الضعف" {
        حاول {
            ليكن الرقم = حقل "الرقم"
            ليكن النتيجة = الرقم * 2
            أظهر "النتيجة: {النتيجة}"
        }
        امسك خطأ {
            أظهر "حدث خطأ! تأكد من إدخال رقم"
        }
    }

    عند النقر على "احفظ الاسم" {
        احفظ "اسم_المستخدم" من "الرقم"
        أظهر "تم الحفظ!"
    }

    عند النقر على "عرض الاسم" {
        ليكن الاسم = استرجع "اسم_المستخدم"
        أظهر "الاسم المحفوظ: {الاسم}"
    }
}