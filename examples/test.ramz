شكل {
    صفحة "الرئيسية" {
        عنوان "حاسبة رَمْز"
        إدخال "الرقم_الأول" "أدخل الرقم الأول"
        إدخال "الرقم_الثاني" "أدخل الرقم الثاني"
        زر "اجمع"
        زر "اطرح"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    دالة جمع(أ، ب) {
        ليكن النتيجة = أ + ب
        أظهر "النتيجة هي {النتيجة}"
    }
    
    دالة طرح(أ، ب) {
        ليكن النتيجة = أ - ب
        أظهر "النتيجة هي {النتيجة}"
    }
    
    عند النقر على "اجمع" {
        جمع(الرقم_الأول, الرقم_الثاني)
    }
    
    عند النقر على "اطرح" {
        طرح(الرقم_الأول, الرقم_الثاني)
    }
}