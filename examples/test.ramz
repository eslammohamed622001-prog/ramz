شكل {
    صفحة "الرئيسية" {
        عنوان "متجر رَمْز"
        
        قائمة "المنتجات" {
            عنصر "لابتوب - 15000 جنيه"
            عنصر "هاتف - 8000 جنيه"
            عنصر "سماعات - 500 جنيه"
        }
        
        زر "إظهار عدد المنتجات"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
    تنسيق "قائمة" {
        خاصية "اللون" = "#C5C6C7"
        خاصية "الحجم" = "1.2em"
    }
}

معنى {
    عند النقر على "إظهار عدد المنتجات" {
        أظهر "لدينا 3 منتجات في المتجر"
    }
}