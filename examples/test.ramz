شكل {
    صفحة "الرئيسية" {
        عنوان "خدماتنا"
        
        بطاقات {
            بطاقة "تصميم المواقع" {
                نص "نصمم مواقع احترافية"
                زر "اعرف أكثر"
            }
            بطاقة "تطوير التطبيقات" {
                نص "نبني تطبيقات الموبايل"
                زر "اعرف أكثر"
            }
            بطاقة "الاستشارات" {
                نص "نقدم استشارات تقنية"
                زر "اعرف أكثر"
            }
        }
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "بطاقة" {
        خاصية "الخلفية" = "#1A1C23"
        خاصية "الحواف" = "16px"
    }
}

معنى {
    عند النقر على "اعرف أكثر" {
        أظهر "سنخبرك بتفاصيل هذه الخدمة قريباً!"
    }
}