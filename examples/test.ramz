شكل {
    صفحة "تجربة" {
        عنوان "حاسبة رَمْز"
        زر "احسب"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    ليكن السعر = 100
    ليكن الكمية = 3
    ليكن الإجمالي = السعر * الكمية
    ليكن الاسم = "أحمد"

    عند النقر على "احسب" {
        أظهر "مرحباً {الاسم}، الإجمالي هو {الإجمالي} جنيه"
    }
}