شكل {
    صفحة "معرض" {
        عنوان "معرض رَمْز"
        صورة "https://via.placeholder.com/400x300/D4AF37/0B0C10?text=Ramz+Image"
        فيديو "https://www.w3schools.com/html/mov_bbb.mp4"
        زر "ابدأ العرض"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    ليكن العداد = 1

    عند النقر على "ابدأ العرض" {
       كرر 3 مرات {
            أظهر "هذا العرض رقم {العداد}"
            ليكن العداد = العداد + 1
        }
    }
}