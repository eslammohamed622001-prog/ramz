شكل {
    صفحة "تجربة" {
        عنوان "أهلاً بك في رَمْز"
        إدخال "اسمك" "اكتب اسمك هنا..."
        زر "تحية"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    عند النقر على "تحية" {
        أظهر "مرحباً بك يا {اسمك}، نورت لغة رَمْز!"
    }
}