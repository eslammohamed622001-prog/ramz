// ملف اختبار شامل - يجمع بين شَكْل، طِراز، ومَعنى

شكل {
    صفحة "تجربة" {
        عنوان "أهلاً بك في رَمْز"
        زر "ابدأ"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "الحجم" = "3em"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    عند النقر على "ابدأ" {
        أظهر "مرحباً بك في عالم رَمْز! 🎉"
    }
}