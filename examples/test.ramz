شكل {
    صفحة "تجربة" {
        عنوان "شروط رَمْز"
        زر "تحقق"
    }
}

طراز {
    تنسيق "عنوان" {
        خاصية "اللون" = "#D4AF37"
        خاصية "المحاذاة" = "وسط"
    }
    تنسيق "زر" {
        خاصية "الخلفية" = "#D4AF37"
        خاصية "اللون" = "#0B0C10"
        خاصية "الحواف" = "12px"
    }
}

معنى {
    ليكن العمر = 15

    عند النقر على "تحقق" {
        إذا العمر >= 18 {
            أظهر "أهلاً بك، أنت بالغ!"
        } وإلا {
            أظهر "عذراً، يجب أن يكون عمرك 18 أو أكثر"
        }
    }
}